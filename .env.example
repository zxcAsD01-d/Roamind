# Copy to .env. Paths may be absolute or relative to the project root.
MOTION_LAB_URL=http://127.0.0.1:8100
MOTION_PERCEPTION_URL=http://127.0.0.1:8200
VITE_MOTION_LAB_URL=http://127.0.0.1:8100
VITE_MOTION_PERCEPTION_URL=http://127.0.0.1:8200
MOTION_VRM_DIR=models/avatars
# Empty means discover all .vrm files in MOTION_VRM_DIR.
MOTION_VRM_FILES=
MOTION_ARDY_ASSETS_DIR=models/ardy
MOTION_LUMEN_DIR=external/HAST-SEC
ARDY_ROOT=external/ardy
ARDY_EMBEDDINGS=.local-data/embeddings.npz
ARDY_WARMUP=0
SMPL_MODEL_PATH=models/smpl/SMPL_NEUTRAL.pkl
MOTION_AMASS_DIR=datasets/amass/raw
MOTION_TOOLS_ROOT=.local-data
MOTION_SERVICE_DIR=public/service
# Optional interpreter overrides; otherwise an existing project venv is used.
MOTION_PYTHON=
ARDY_PYTHON=
MOTION_PERCEPTION_PYTHON=
MOTION_MCP_PYTHON=

# Optional Chat Completions compatible high-level LLM endpoint.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
